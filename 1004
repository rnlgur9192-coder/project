def _render_day2(data):
    st.subheader("2일차 · 조회 결과 → LLM 요약 → 원본 근거 비교")
    mode = st.radio(
        "실행 모드",
        ["연습 모드", "실제 LLM 모드"],
        horizontal=True,
        key="day2_mode",
    )
    mock_failure = False
    mock_count_delta = 0
    mock_amount_delta = 0
    if mode == "연습 모드":
        st.info("연습 모드입니다. 아래 요약은 LLM이 아니라 Python이 만드는 모의 응답입니다.")
        mock_failure = st.checkbox("모의 API 실패 만들기", key="day2_mock_failure")
        with st.expander("도전 · 숫자 불일치 만들기"):
            mock_count_delta = 1 if st.checkbox("모의 건수를 1 늘리기", key="day2_count_delta") else 0
            mock_amount_delta = 1 if st.checkbox("모의 금액을 1원 늘리기", key="day2_amount_delta") else 0
    else:
        st.warning("실제 LLM 모드입니다. 환경변수의 API 키와 모델을 사용하며 비용이 발생할 수 있습니다.")

    status, product, minimum = _filter_inputs("day2")
    if st.button("조회하고 요약", type="primary", key="day2_summarize"):
        filters = {"status": status, "product_type": product, "min_amount": minimum}
        rows = search_claims(data, status, product, minimum)
        if not rows:
            st.session_state["day2_result"] = {"empty": True, "rows": rows, "filters": filters}
        else:
            context_json = make_summary_context(rows, filters)
            try:
                summary = summarize_rows(
                    rows,
                    context_json,
                    mock_mode=mode == "연습 모드",
                    mock_failure=mock_failure,
                    mock_count_delta=mock_count_delta,
                    mock_amount_delta=mock_amount_delta,
                )
                validation = validate_summary(summary, rows)
                st.session_state["day2_result"] = {
                    "empty": False,
                    "rows": rows,
                    "filters": filters,
                    "context_json": context_json,
                    "summary": summary,
                    "validation": validation,
                    "error": None,
                }
            except Exception as error:  # 화면에서는 내부 비밀값 대신 안내 문구만 표시합니다.
                st.session_state["day2_result"] = {
                    "empty": False,
                    "rows": rows,
                    "filters": filters,
                    "context_json": context_json,
                    "error": get_user_error_message(error),
                }

    result = st.session_state.get("day2_result")
    if not result:
        return
    if result["empty"]:
        st.info("조건에 맞는 데이터가 없습니다. 다른 조건을 선택하세요.")
        st.caption("조회 결과가 0건이므로 요약 함수를 호출하지 않았습니다.")
        return
    if result.get("error"):
        st.error(result["error"])
        return

    left, right = st.columns([1, 1])
    with left:
        summary = result["summary"]
        label = "Python 모의 요약" if summary["source"] == "mock" else "OpenAI LLM 요약"
        st.markdown(f"#### {label}")
        st.write(summary["summary"])
        first, second = st.columns(2)
        first.metric("요약 건수", f"{summary['record_count']}건")
        second.metric("요약 청구금액", f"{summary['total_claim_amount_krw']:,}원")
        st.write("공통 문의:", ", ".join(summary["common_topics"]))
        validation = result["validation"]
        if validation["count_ok"] and validation["amount_ok"]:
            st.success("요약의 건수와 청구금액이 원본 기준값과 일치합니다.")
        else:
            if not validation["count_ok"]:
                st.warning(f"건수 불일치: 원본은 {validation['expected_count']}건입니다.")
            if not validation["amount_ok"]:
                st.warning(f"금액 불일치: 원본 합계는 {validation['expected_total']:,}원입니다.")
        comparison_rows = [
            {
                "비교 항목": "조회 건수",
                "Python 원본": validation["expected_count"],
                "요약 응답": summary["record_count"],
                "일치 여부": "일치" if validation["count_ok"] else "불일치",
            },
            {
                "비교 항목": "청구금액 합계",
                "Python 원본": validation["expected_total"],
                "요약 응답": summary["total_claim_amount_krw"],
                "일치 여부": "일치" if validation["amount_ok"] else "불일치",
            },
        ]
        st.dataframe(pd.DataFrame(comparison_rows), width="stretch", hide_index=True)
    with right:
        st.markdown("#### 조회 조건과 원본 근거")
        st.json(result["filters"])
        safe_rows = make_safe_rows(result["rows"])
        forbidden = find_forbidden_columns(safe_rows)
        if forbidden:
            st.error(f"전달 금지 컬럼이 남아 있습니다: {', '.join(forbidden)}")
        else:
            st.success("LLM Context에서 이름과 전화번호를 제외했습니다.")
        with st.expander("실제 LLM 전달 데이터 보기"):
            st.code(result["context_json"], language="json")
        st.dataframe(pd.DataFrame(result["rows"]), width="stretch", hide_index=True)


def _render_day3(data):
    st.subheader("3단계 복습 · 자연어 질문 → LLM 도구 선택 → Python 조회 → 최종 답변")
    question = st.text_area(
        "자연어 질문",
        value="심사 중인 자동차보험 청구 중 30만 원 이상인 건을 찾아 주요 문의를 정리해줘.",
        height=100,
    )
    st.caption("실제 개인정보, API 키, 비밀값은 질문에 입력하지 마세요.")
    first, second = st.columns(2)
    with first:
        mode = st.radio("실행 모드", ["연습 모드", "실제 LLM 모드"], horizontal=True, key="day3_mode")
    with second:
        description_version = st.radio(
            "도구 설명",
            ["A", "B"],
            index=1,
            format_func=lambda value: f"{value} · {TOOL_DESCRIPTIONS[value]}",
            key="description_version",
        )
    if mode == "연습 모드":
        st.info("연습 모드입니다. function_call과 최종 문장은 Python이 만든 모의 데이터입니다.")
    else:
        st.warning("실제 LLM 모드입니다. OpenAI Responses API를 두 번 호출할 수 있습니다.")

    if st.button("AI 도구 실행", type="primary", key="day3_run"):
        try:
            if not question.strip():
                raise ValueError("질문을 입력하세요.")
            if mode == "연습 모드":
                result = run_mock_tool_flow(question, data, description_version)
            else:
                result = run_live_tool_flow(question, data, description_version)
            st.session_state["day3_result"] = {"result": result, "error": None}
        except Exception as error:
            st.session_state["day3_result"] = {"result": None, "error": get_user_error_message(error)}

    state = st.session_state.get("day3_result")
    if not state:
        return
    if state["error"]:
        st.error(state["error"])
        return
    result = state["result"]
    st.markdown("#### 실행 흐름")
    step_columns = st.columns(5)
    for column, step in zip(step_columns, build_execution_steps(result)):
        column.metric(step["단계"], step["상태"])
        column.caption(step["설명"])

    st.markdown("#### 도구 호출 기록")
    if not result["tool_called"]:
        st.warning("모델이 조회 도구를 호출하지 않았습니다. 도구 설명을 바꿔 다시 비교해 보세요.")
        st.write(result["final_answer"])
        return

    original_rows = search_claims(
        data,
        result["arguments"]["status"],
        result["arguments"]["product_type"],
        result["arguments"]["min_amount"],
    )
    log_tab, answer_tab, evidence_tab, payload_tab = st.tabs(
        ["호출 기록", "최종 답변", "원본 근거", "안전한 도구 결과"]
    )
    with log_tab:
        first, second, third = st.columns(3)
        first.metric("호출 도구", result["tool_name"])
        second.metric("Python 조회", f"{result['record_count']}건")
        third.metric("call_id", result["call_id"])
        st.write("LLM이 만든 입력 인자")
        st.json(result["arguments"])
    with answer_tab:
        st.info(result["question"])
        st.write(result["final_answer"])
    with evidence_tab:
        if original_rows:
            evidence_columns = [
                "case_id",
                "product_type",
                "status",
                "claim_amount_krw",
                "consultation_note",
            ]
            st.dataframe(
                pd.DataFrame(original_rows)[evidence_columns],
                width="stretch",
                hide_index=True,
            )
        else:
            st.info("조건에 맞는 데이터가 없습니다. 다른 질문을 입력하세요.")
    with payload_tab:
        st.caption("customer_name과 phone은 모델에 반환하지 않습니다.")
        st.json(result["tool_result"])
        with st.expander("function_call_output 구조"):
            st.json(result["tool_output_item"])


