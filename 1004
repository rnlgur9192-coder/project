# DAY4-TODO 1 정답 — JSON 파일을 UTF-8로 열고 list인지 확인합니다.
def load_claims(data_file=DATA_FILE):
    """UTF-8 JSON 파일을 읽어 청구 목록을 반환합니다."""
    with Path(data_file).open(encoding="utf-8-sig") as file:
        data = json.load(file)
    if not isinstance(data, list):
        raise ValueError("보험금 청구 JSON의 최상위 값은 list여야 합니다.")
    return data


# DAY4-TODO 2 정답 — 세 조회 조건을 모두 적용합니다.
def search_claims(data, status, product_type="전체", min_amount=0):
    """상태, 상품, 최소 청구금액을 모두 만족하는 행만 반환합니다."""
    result = []
    for row in data:
        if status != "전체" and row["status"] != status:
            continue
        if product_type != "전체" and row["product_type"] != product_type:
            continue
        if row["claim_amount_krw"] < min_amount:
            continue
        result.append(row)
    return result


def calculate_summary_values(rows):
    """원본 행을 기준으로 조회 건수와 청구금액 합계를 계산합니다."""
    return len(rows), sum(row["claim_amount_krw"] for row in rows)


# DAY4-TODO 3 정답 — 화면 카드에 필요한 건수·합계·평균·최댓값을 계산합니다.
def calculate_dashboard_values(rows):
    """조회 결과 대시보드의 네 가지 기준값을 반환합니다."""
    count, total = calculate_summary_values(rows)
    amounts = [row["claim_amount_krw"] for row in rows]
    return {
        "record_count": count,
        "total_amount": total,
        "average_amount": round(total / count) if count else 0,
        "max_amount": max(amounts, default=0),
    }


# DAY4-TODO 4 정답 — LLM에 허용한 컬럼만 새 dict에 복사하고 다시 검사합니다.
def make_safe_rows(rows):
    """LLM에 전달 가능한 컬럼만 새 dict에 복사합니다."""
    return [{column: row[column] for column in SAFE_COLUMNS} for row in rows]


# 제공 코드 — DAY4-TODO 4 결과에서 금지 컬럼이 남았는지 다시 검사합니다.
def find_forbidden_columns(rows):
    """안전한 행에 이름·전화번호가 남았는지 확인합니다."""
    forbidden = {"customer_name", "phone"}
    return sorted({column for row in rows for column in row if column in forbidden})


# DAY4-TODO 5 정답 — 조건·Python 기준값·안전한 행을 Context JSON으로 만듭니다.
def make_summary_context(rows, filters):
    """요약 기준값, 조회 조건, 안전한 행을 JSON 문자열로 만듭니다."""
    record_count, total_amount = calculate_summary_values(rows)
    context = {
        "filters": {
            "status": filters.get("status", "전체"),
            "product_type": filters.get("product_type", "전체"),
            "min_amount": int(filters.get("min_amount", 0)),
        },
        "record_count": record_count,
        "total_claim_amount_krw": total_amount,
        "records": make_safe_rows(rows),
    }
    return json.dumps(context, ensure_ascii=False, indent=2)


def _common_topics_from_rows(rows):
    text = " ".join(row["consultation_note"] for row in rows)
    topics = []
    if any(word in text for word in ["서류", "영수증", "자료"]):
        topics.append("추가 서류 확인")
    if any(word in text for word in ["진행", "단계", "심사"]):
        topics.append("처리 단계 확인")
    if "금액" in text:
        topics.append("청구금액 확인")
    if "접수" in text:
        topics.append("접수 여부 확인")
    return topics[:3] or ["문의 내용 확인"]


def _validate_summary_shape(result):
    required_types = {
        "summary": str,
        "record_count": int,
        "total_claim_amount_krw": int,
        "common_topics": list,
    }
    if not isinstance(result, dict):
        raise ValueError("요약 응답은 JSON object여야 합니다.")
    for key, expected_type in required_types.items():
        if key not in result or not isinstance(result[key], expected_type):
            raise ValueError(f"요약 응답의 {key} 형식을 확인하세요.")
    if not all(isinstance(topic, str) for topic in result["common_topics"]):
        raise ValueError("common_topics의 각 항목은 문자열이어야 합니다.")


# DAY4-TODO 6 정답 — API 키 없이 연습할 Python 모의 요약을 만듭니다.
def make_mock_summary(context_json, count_delta=0, amount_delta=0):
    context = json.loads(context_json)
    rows = context["records"]
    topics = _common_topics_from_rows(rows)
    count = context["record_count"]
    total = context["total_claim_amount_krw"]
    topic_text = ", ".join(topics)
    return {
        "summary": f"조회 결과는 {count}건이며 청구금액 합계는 {total:,}원입니다. 주요 문의는 {topic_text}입니다.",
        "record_count": count + count_delta,
        "total_claim_amount_krw": total + amount_delta,
        "common_topics": topics,
        "source": "mock",
    }


def _make_openai_client():
    if load_dotenv is not None:
        load_dotenv()
    if not os.getenv("OPENAI_API_KEY"):
        raise MissingApiKeyError("OPENAI_API_KEY가 없습니다.")
    if OpenAI is None:
        raise RuntimeError("openai 패키지가 설치되어 있지 않습니다.")
    return OpenAI()


def summarize_with_llm(
    context_json,
    mock_mode=True,
    mock_failure=False,
    mock_count_delta=0,
    mock_amount_delta=0,
    client=None,
    model=None,
):
    """연습 모의 응답 또는 Responses API의 Structured Output을 반환합니다."""
    if mock_mode:
        if mock_failure:
            raise MockApiError("연습용 API 실패")
        return make_mock_summary(context_json, mock_count_delta, mock_amount_delta)

    client = client or _make_openai_client()
    model = model or os.getenv("OPENAI_MODEL", DEFAULT_MODEL)
    response = client.responses.create(
        model=model,
        input=[
            {"role": "system", "content": SUMMARY_INSTRUCTIONS},
            {"role": "user", "content": f"다음 Context를 요약하세요.\n{context_json}"},
        ],
        text={
            "format": {
                "type": "json_schema",
                "name": "claim_summary",
                "strict": True,
                "schema": SUMMARY_SCHEMA,
            }
        },
        store=False,
    )
    raw_text = getattr(response, "output_text", "")
    if not raw_text:
        raise EmptyResponseError("응답 텍스트가 없습니다.")
    result = json.loads(raw_text)
    _validate_summary_shape(result)
    result["source"] = "openai"
    return result


# DAY4-TODO 7 정답 — 빈 결과는 요약을 건너뛰고, 나머지만 요약 함수에 전달합니다.
def summarize_rows(rows, context_json, mock_mode=True, **kwargs):
    """조회 결과가 있을 때만 연습 또는 실제 요약을 실행합니다."""
    if not rows:
        return None
    return summarize_with_llm(context_json, mock_mode=mock_mode, **kwargs)


# DAY4-TODO 8 정답 — 요약의 건수·금액을 Python 원본 기준값과 비교합니다.
def validate_summary(summary_result, original_rows):
    """LLM 숫자와 Python이 원본에서 계산한 기준값을 비교합니다."""
    expected_count, expected_total = calculate_summary_values(original_rows)
    return {
        "count_ok": summary_result.get("record_count") == expected_count,
        "amount_ok": summary_result.get("total_claim_amount_krw") == expected_total,
        "expected_count": expected_count,
        "expected_total": expected_total,
    }


def get_user_error_message(error):
    """내부 예외를 비밀값이 없는 사용자 안내 문구로 바꿉니다."""
    if isinstance(error, NotImplementedError):
        return str(error)
    if isinstance(error, MissingApiKeyError):
        return "OPENAI_API_KEY가 없습니다. .env 파일을 확인하거나 연습 모드를 선택하세요."
    if isinstance(error, MockApiError):
        return "연습용 실패가 발생했습니다. 실제 API 장애가 아니라 오류 화면 확인용입니다."
    if isinstance(error, EmptyResponseError):
        return "응답 텍스트가 없습니다. 잠시 후 다시 시도하세요."
    if isinstance(error, json.JSONDecodeError):
        return "응답을 JSON으로 읽지 못했습니다. 응답 형식과 Schema를 확인하세요."
    if isinstance(error, (ToolInputError, ToolNameError)):
        return f"도구 실행을 중단했습니다: {error}"
    message = str(error).lower()
    if "model" in message and any(word in message for word in ["access", "not found", "does not exist", "unsupported"]):
        return "선택한 모델을 이 계정에서 사용할 수 없습니다. OPENAI_MODEL 값을 확인하세요."
    return "API 요청 또는 응답 처리에 실패했습니다. 네트워크, 모델, 사용 한도와 오류 로그를 확인하세요."


