class MissingApiKeyError(RuntimeError):
    """OPENAI_API_KEY가 없을 때 사용합니다."""


class EmptyResponseError(RuntimeError):
    """응답에 output_text가 없을 때 사용합니다."""


class MockApiError(RuntimeError):
    """수업에서 실패 화면을 연습하기 위해 발생시키는 오류입니다."""


class ToolInputError(ValueError):
    """모델이 만든 도구 인자가 허용 범위를 벗어났을 때 사용합니다."""


class ToolNameError(ValueError):
    """허용 목록에 없는 도구 이름일 때 사용합니다."""


